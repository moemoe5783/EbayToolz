NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_WiaZj2KnQdSFu4PYg4kddg_4e6Y7tos

# Supabase Service Role Key (server-side only — bypasses RLS)
# Required for eBay OAuth token storage (ebay_oauth_tokens table)
# Get from: Supabase dashboard > Project Settings > API > service_role key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=https://ebay.mytoolz.work


# ─── eBay API (OAuth + order sync) ───────────────────────────────────────────
# Step-by-step setup:
#
# 1. Copy your PRODUCTION keys from https://developer.ebay.com/my/keys:
#      EBAY_CLIENT_ID=
#      EBAY_CLIENT_SECRET=          ← server-only, never add NEXT_PUBLIC_ prefix
#
# 2. Register the OAuth callback URL — in the developer portal open your keyset,
#    click "User Tokens" → "Get a Token from eBay via Your Application", then add:
#      Redirect URL:  https://ebay.mytoolz.work/api/ebay/callback
#    eBay generates a "RuName" (e.g. YourName-AppName-PRD-xxxxxxxx-xxxxxxxx).
#    That RuName — NOT the URL — goes here:
#      EBAY_RUNAME=
#
# 3. EBAY_ENVIRONMENT=PRODUCTION
#
# 4. Generate a 32-byte encryption key for storing tokens at rest:
#    Run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#      EBAY_TOKEN_ENCRYPTION_KEY=
#
# 5. Make up any 32–80 char string for the account-deletion webhook:
#      EBAY_VERIFICATION_TOKEN=
#    Then in the developer portal → Alerts & Notifications, register:
#      https://ebay.mytoolz.work/api/ebay/notifications/account-deletion

# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_RUNAME=
# EBAY_ENVIRONMENT=PRODUCTION
# EBAY_TOKEN_ENCRYPTION_KEY=
# EBAY_VERIFICATION_TOKEN=
