# Supabase Project Configuration
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xozswskfbofsjlxalbnw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_WiaZj2KnQdSFu4PYg4kddg_4e6Y7tos

# Supabase Service Role Key (server-side only — bypasses RLS)
# Required for eBay OAuth token storage (ebay_oauth_tokens table)
# Get from: Supabase dashboard > Project Settings > API > service_role key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=https://ebay.mytoolz.work

# ─── eBay API (OAuth + order sync) ───────────────────────────────────────────
# Register at https://developer.ebay.com/my/keys
# EBAY_CLIENT_ID=your-ebay-client-id
# EBAY_CLIENT_SECRET=your-ebay-client-secret   ← never use NEXT_PUBLIC_ prefix
# EBAY_REDIRECT_URI=https://ebay.mytoolz.work/api/ebay/callback
# EBAY_ENVIRONMENT=PRODUCTION   # or SANDBOX for testing

# AES-256-GCM key for encrypting eBay tokens at rest (64 hex chars = 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# EBAY_TOKEN_ENCRYPTION_KEY=your-64-hex-char-key-here

# Verification token for the Marketplace Account Deletion webhook endpoint.
# Make up any 32–80 character string, paste it into the eBay developer portal
# when registering: https://ebay.mytoolz.work/api/ebay/notifications/account-deletion
# EBAY_VERIFICATION_TOKEN=your-32-to-80-char-random-string-here
