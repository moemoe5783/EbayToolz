{
  "manifest_version": 3,
  "name": "EbayToolz Amazon Scraper",
  "version": "1.0.0",
  "description": "Scrape Amazon order and product data directly into EbayToolz",

  "permissions": ["storage", "activeTab", "scripting"],

  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.ca/*",
    "https://xozswskfbofsjlxalbnw.supabase.co/*",
    "https://ebay.mytoolz.work/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "EbayToolz Amazon Scraper"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.ca/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js"
  }
}
